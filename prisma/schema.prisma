datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Team {
  leadership
  creative
  curation
  partnerships
  media
  technology
}

model Member {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  role         String      // Actual designation e.g. "Executive Producer", "Technical Lead"
  team         Team        // 6-group visual theme key
  oneLiner     String
  bio          String
  contribution String
  interests    String      @default("[]") // JSON string array
  photoUrl     String      @default("/members/placeholder.png")
  linkedin     String?
  instagram    String?
  github       String?
  portfolio    String?
  email        String?
  scanCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  scans        ScanEvent[]
}

model ScanEvent {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  scannedAt DateTime @default(now())
  source    String?  // e.g. "qr" vs "direct-link"
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
